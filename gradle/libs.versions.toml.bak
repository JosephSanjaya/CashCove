[versions]
min-sdk = "24"
target-sdk = "36"
compile-sdk = "36"
jvm-target = "21"
desugar = "2.1.5"
agp = "8.13.0"
kotlin = "2.2.20"


[libraries]
androidx-desugar = { module = "com.android.tools:desugar_jdk_libs", version.ref = "desugar" }

[bundles]

[plugins]
